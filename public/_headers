# En-têtes de sécurité (Cloudflare Pages / Netlify).
# Sur Vercel, les en-têtes sont gérés par la plateforme.

/*
  # Empêche l'app d'être encapsulée dans une iframe tierce : sans cela,
  # un site malveillant peut la superposer à ses propres boutons et
  # capter les taps de l'utilisateur.
  X-Frame-Options: SAMEORIGIN
  # Bloque l'interprétation d'un fichier dans un type qu'il n'annonce pas.
  X-Content-Type-Options: nosniff
  # Ne fuite pas l'URL complète vers les domaines tiers.
  Referrer-Policy: strict-origin-when-cross-origin
  # Aucune de ces capacités n'est utilisée hors du microphone (dictée).
  Permissions-Policy: camera=(), geolocation=(), payment=(), usb=(), microphone=(self)
  # Force HTTPS pendant deux ans.
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  # Politique de contenu : les données patrimoniales vivent dans le
  # stockage local, qu'une injection de script pourrait lire. L'app
  # n'utilise que des polices système et n'appelle que ses propres
  # routes : tout le reste est donc interdit.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; worker-src 'self'; manifest-src 'self'

/assets/*
  cache-control: public, max-age=31536000, immutable
